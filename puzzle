    <script>
        function showError(img, filename) {
            img.style.display = 'none';
            // Find the missing-img-msg div which is the next sibling
            var msgDiv = img.nextElementSibling;
            if (msgDiv && msgDiv.classList.contains('missing-img-msg')) {
                msgDiv.style.display = 'block';
            }
        }
    </script>

