<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Word Search Puzzle Master Key</title>
    <style>
        :root {
            --primary-color: #2c3e50;
            --accent-color: #3498db;
            --hard-color: #e67e22;
            --impossible-color: #c0392b;
            --bg-color: #f5f7fa;
            --card-bg: #ffffff;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-color);
            color: var(--primary-color);
            line-height: 1.6;
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }
        /* Instructions Box */
        .instructions {
            background-color: #fff3cd;
            border: 1px solid #ffeeba;
            color: #856404;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 30px;
            text-align: center;
        }
        h1 {
            text-align: center;
            margin-bottom: 40px;
            color: var(--primary-color);
        }
        .level-section {
            margin-bottom: 50px;
            border-top: 4px solid var(--primary-color);
            padding-top: 20px;
        }
        .level-title {
            background-color: var(--primary-color);
            color: white;
            padding: 10px 20px;
            border-radius: 8px;
            display: inline-block;
            margin-bottom: 20px;
        }
        .puzzle-card {
            background: var(--card-bg);
            border-radius: 12px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
            margin-bottom: 40px;
            padding: 25px;
            page-break-inside: avoid;
        }
        .puzzle-header {
            border-bottom: 1px solid #eee;
            margin-bottom: 20px;
            padding-bottom: 10px;
        }
        .puzzle-header h3 {
            margin: 0;
            font-size: 1.4rem;
        }
        .puzzle-meta {
            color: #666;
            font-style: italic;
        }
        
        /* Grid Layout for Images */
        .images-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 20px;
        }
        .image-box {
            text-align: center;
            background: #eee;
            border-radius: 8px;
            padding: 10px;
            min-height: 300px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            border: 2px dashed #ccc;
            position: relative;
        }
        .image-box img {
            max-width: 100%;
            height: auto;
            border-radius: 4px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            display: block; /* Hidden by default if broken via JS */
        }
        .image-label {
            margin-top: 10px;
            font-weight: bold;
            color: var(--primary-color);
            background: rgba(255,255,255,0.9);
            padding: 5px 15px;
            border-radius: 15px;
        }

        /* Error Message for Missing Images */
        .missing-img-msg {
            display: none;
            color: #721c24;
            background-color: #f8d7da;
            padding: 10px;
            border-radius: 5px;
            font-size: 0.9rem;
            width: 90%;
        }

        .word-list {
            background-color: #eef2f7;
            padding: 15px;
            border-radius: 8px;
            border-left: 5px solid var(--accent-color);
        }

        /* Print Optimization */
        @media print {
            body { background-color: white; }
            .instructions { display: none; }
            .puzzle-card { box-shadow: none; border: 1px solid #ddd; break-inside: avoid; }
            .image-box { border: none; background: none; min-height: auto; }
        }
        @media (max-width: 768px) {
            .images-container { grid-template-columns: 1fr; }
        }
    </style>
</head>
